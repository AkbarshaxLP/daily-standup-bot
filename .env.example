# ─── Telegram Bot ───────────────────────────────────────────────
# Получить у @BotFather
BOT_TOKEN=

# ─── MTProto User Client ─────────────────────────────────────────
# Получить на https://my.telegram.org → API development tools
API_ID=
API_HASH=
# Номер телефона аккаунта-наблюдателя (формат: +79001234567)
PHONE_NUMBER=

# ─── Группа ──────────────────────────────────────────────────────
# ID чата (узнать командой /chatid после добавления бота в группу)
GROUP_CHAT_ID=

# ─── Администраторы (необязательно) ──────────────────────────────
# Telegram ID через запятую, кто может использовать /add /remove
# Если не указать — команды доступны всем
ADMIN_IDS=
